<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>globalprotect-native</vendor>
  <vendor_url>https://github.com/dvjn/globalprotect-native</vendor_url>
  <action id="org.dvjn.globalprotect-native.control">
    <description>Control the GlobalProtect VPN</description>
    <message>Authentication is required to control the GlobalProtect VPN</message>
    <defaults>
      <allow_any>auth_admin_keep</allow_any>
      <allow_inactive>auth_admin_keep</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>
</policyconfig>
