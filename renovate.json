{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":disableRateLimiting",
    "customManagers:githubActionsVersions"
  ],
  "postUpdateOptions": ["gomodTidy", "gomodUpdateImportPaths"],
  "packageRules": [
    {
      "matchManagers": ["gomod"],
      "matchDatasources": ["go"],
      "groupName": "go modules",
      "separateMajorMinor": false
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "github actions",
      "separateMajorMinor": false
    },
    {
      "matchManagers": ["mise"],
      "groupName": "mise tools",
      "separateMajorMinor": false
    },
    {
      "description": "What ships in the binary gets the deps type, which release-please lists under Dependencies",
      "matchManagers": ["gomod"],
      "semanticCommitType": "deps",
      "semanticCommitScope": null
    },
    {
      "matchManagers": ["mise"],
      "matchPackageNames": ["go"],
      "semanticCommitType": "deps",
      "semanticCommitScope": null
    },
    {
      "matchPackageNames": ["jdx/mise"],
      "groupName": "mise tools"
    }
  ],
  "vulnerabilityAlerts": { "semanticCommitType": "fix", "semanticCommitScope": "deps" },
  "dependencyDashboard": true,
  "osvVulnerabilityAlerts": true
}
